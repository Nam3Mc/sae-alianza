<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<section class="page-header">
  <div class="container">
    <h1>Transparencia y Gestión Institucional</h1>
    <p>Nuestro compromiso con la rendición de cuentas</p>
  </div>
</section>

<!-- =========================================================
     INTRO + DOCUMENTOS DISPONIBLES BAJO SOLICITUD
     ========================================================= -->
<section class="section">
  <div class="container">
    <header class="section__header">
      <span class="section__tag">Rendición de cuentas</span>
      <h2 class="section__title">Información pública a tu disposición</h2>
      <p class="section__text">
        Como entidad sin ánimo de lucro, ponemos a disposición de la ciudadanía,
        aliados y entes de control la información institucional que respalda
        nuestra gestión y el uso responsable de los recursos.
      </p>
      <p class="section__text">
        <strong>Para obtener los documentos, contacta a la organización.</strong>
        Con gusto te los compartiremos por nuestros canales oficiales.
      </p>
    </header>

    <%
      /* ⚙️ Documentos publicados.
         Ya no se expone el campo `archivo` para evitar enlaces directos. */
      const documentos = [
        {
          nombre: 'Certificado de existencia y representación legal',
          tipo: 'PDF'
        },
        {
          nombre: 'Estatutos de la Corporación',
          tipo: 'PDF'
        },
        {
          nombre: 'Informe de gestión inicial y planeación de actividades',
          tipo: 'PDF'
        },
        {
          nombre: 'Balance de apertura 2026',
          tipo: 'PDF'
        },
        {
          nombre: 'Proyecto de presupuesto — Segundo semestre 2026',
          tipo: 'PDF'
        }
      ];
    %>

    <div class="documentos-grid">
      <% documentos.forEach(function(doc) { %>
        <article class="documento">
          <div class="documento__head">
            <span class="documento__badge" aria-hidden="true"><%= doc.tipo %></span>
            <div class="documento__info">
              <h3 class="documento__nombre"><%= doc.nombre %></h3>
              <p class="documento__meta">
                Documento oficial · Disponible bajo solicitud
              </p>
            </div>
          </div>

          <div class="documento__acciones">
            <a
              href="mailto:<%= datos.correo %>?subject=<%= encodeURIComponent('Solicitud de documento: ' + doc.nombre) %>"
              class="documento__accion documento__accion--solid">
              Solicitar por correo
            </a>
          </div>
        </article>
      <% }); %>
    </div>

    <p class="nota">
      Los documentos no se descargan directamente desde esta página.
      Para obtenerlos, escríbenos por nuestros canales oficiales y te los enviaremos.
    </p>
  </div>
</section>

<!-- =========================================================
     SOLICITUD DE DOCUMENTOS
     ========================================================= -->
<section class="section section--light">
  <div class="container">
    <header class="section__header">
      <span class="section__tag">¿Cómo solicitarlos?</span>
      <h2 class="section__title">Escríbenos y te los enviamos</h2>
      <p class="section__text">
        Puedes solicitar cualquiera de estos documentos por nuestros canales oficiales.
        Responderemos en un plazo máximo de 48 horas hábiles.
      </p>
    </header>

    <div class="contacto-grid">
      <article class="contacto-card">
        <span class="contacto__icon" aria-hidden="true">✉️</span>
        <h3>Correo electrónico</h3>
        <p>
          <a href="mailto:<%= datos.correo %>"><%= datos.correo %></a>
        </p>
      </article>

      <article class="contacto-card">
        <span class="contacto__icon" aria-hidden="true">📱</span>
        <h3>WhatsApp</h3>
        <p>
          <a href="https://wa.me/57<%= datos.whatsapp %>"
             target="_blank"
             rel="noopener noreferrer"><%= datos.whatsapp %></a>
        </p>
      </article>

      <article class="contacto-card">
        <span class="contacto__icon" aria-hidden="true">🏛️</span>
        <h3>Sede</h3>
        <p><%= datos.ciudad %></p>
      </article>
    </div>

    <p class="nota">
      La información aquí relacionada se publica en cumplimiento de la Ley 1712 de 2014
      (Ley de Transparencia y del Derecho de Acceso a la Información Pública Nacional).
    </p>
  </div>
</section>